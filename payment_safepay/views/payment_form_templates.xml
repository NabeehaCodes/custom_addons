<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="safepay_inline_form" model="ir.ui.view">
        <field name="name">payment.safepay.inline.form</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">

            <div class="o_payment_safepay_form">

                <h4>SafePay Checkout</h4>

                <div class="mb-3">
                    <label class="form-label">
                        Card Number
                    </label>

                    <div id="number-container"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Security Code (CVV)
                    </label>

                    <div id="securityCode-container"></div>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label
                            for="expMonth"
                            class="form-label">
                            Expiry Month
                        </label>

                        <select
                            id="expMonth"
                            class="form-select">

                            <option value="01">01</option>
                            <option value="02">02</option>
                            <option value="03">03</option>
                            <option value="04">04</option>
                            <option value="05">05</option>
                            <option value="06">06</option>
                            <option value="07">07</option>
                            <option value="08">08</option>
                            <option value="09">09</option>
                            <option value="10">10</option>
                            <option value="11">11</option>
                            <option value="12">12</option>

                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label
                            for="expYear"
                            class="form-label">
                            Expiry Year
                        </label>

                        <select
                            id="expYear"
                            class="form-select">

                            <option value="2026">2026</option>
                            <option value="2027">2027</option>
                            <option value="2028">2028</option>
                            <option value="2029">2029</option>
                            <option value="2030">2030</option>

                        </select>
                    </div>

                </div>

                <div
                    id="safepay-errors-output"
                    class="alert alert-danger d-none"
                    role="alert">
                </div>

                <button
                    type="button"
                    id="safepay-secure-btn"
                    class="btn btn-primary w-100 mt-3">

                    Pay Securely

                </button>

                <div
                    id="safepay-processing"
                    class="text-muted mt-2"
                    style="display:none;">

                    Processing payment...

                </div>

                <iframe
                    id="cardinal-frame"
                    name="cardinal-frame"
                    style="display:none;">
                </iframe>

            </div>

        </field>
    </record>

</odoo>

