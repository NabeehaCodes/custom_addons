<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="payment_provider_safepay_form" model="ir.ui.view">
        <field name="name">payment.provider.safepay.form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <field name="safepay_client_id" invisible="code != 'safepay'"/>
                <field name="safepay_secret_key" password="True"
                       invisible="code != 'safepay'"/>
                <field name="safepay_api_url" invisible="code != 'safepay'"/>

            </xpath>

        </field>
    </record>

</odoo>