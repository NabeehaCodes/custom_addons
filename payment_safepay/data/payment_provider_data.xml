<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="payment_provider_safepay" model="payment.provider">

        <field name="name">SafePay</field>

        <field name="code">safepay</field>

        <field name="state">enabled</field>

        <field name="is_published">True</field>

        <field
            name="inline_form_view_id"
            ref="payment_safepay.safepay_inline_form"
        />

        <field
            name="payment_method_ids"
            eval="[Command.set([ref('payment.payment_method_card')])]"
        />

    </record>

</odoo>

